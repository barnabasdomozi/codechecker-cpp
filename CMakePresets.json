{
  "version": 6,
  "configurePresets": [
    {
      "name": "deps",
      "displayName": "The third-party libraries, built once for every preset",
      "binaryDir": "${sourceDir}/build/deps",
      "cacheVariables": { "CC_DEPS_ONLY": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Debug build with unit tests",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "dev-clang",
      "displayName": "dev, built with Clang",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan",
      "displayName": "dev, with AddressSanitizer and UBSan",
      "inherits": "dev",
      "cacheVariables": { "CC_SANITIZE": "address;undefined" }
    },
    {
      "name": "release",
      "displayName": "Optimized build with debug info",
      "inherits": "dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "analyzer",
      "displayName": "dev, analyzer side only",
      "inherits": "dev",
      "cacheVariables": { "CC_BUILD_WEB": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "deps", "configurePreset": "deps" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-clang", "configurePreset": "dev-clang" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "analyzer", "configurePreset": "analyzer" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "dev-clang", "configurePreset": "dev-clang", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "analyzer", "configurePreset": "analyzer", "output": { "outputOnFailure": true } }
  ]
}
